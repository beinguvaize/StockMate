# Copy to .env and fill in values for your local environment.
# Prod/staging deployments set these in their platform (Vercel) env config.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ENV=development

# Bootstrap allowlist for first-login auto-provisioning.
# Comma-separated list of emails that should be auto-elevated to GLOBAL_ADMIN+OWNER
# on their very first login when no user profile yet exists. After the first admin
# is provisioned, manage elevation through the normal Users admin UI.
# Leave empty in production unless you need initial seeding.
VITE_BOOTSTRAP_ADMIN_EMAILS=

# Tenants that bill from the local database (IndexedDB catalogue + outbox)
# instead of reading the server on every query. Comma-separated tenant ids.
#
# Empty means every web tenant keeps the server-first behaviour; the desktop
# app is local-first regardless, as it has always been. One machine can be
# switched on or off without a deploy by setting localStorage 'sm.localFirst'
# to 'on' or 'off' — 'off' wins over everything, including desktop, so a till
# in trouble has a way back that does not need one.
VITE_LOCAL_FIRST_TENANTS=
