# Playwright e2e credentials. Copy to .env and fill in.
# .env is gitignored — never commit real values. A working login was previously
# hardcoded in tests/helpers/auth.ts and reached a public repository.
E2E_EMAIL=
E2E_PASSWORD=

# Which tenant the suite runs against. Defaults to demo-kirana-store.
# These tests CREATE AND MODIFY records, so never point this at a live
# customer -- future-dispo-industries is refused outright.
E2E_TENANT_SLUG=demo-kirana-store

# ── ImmigrationTracker e2e suite (playwright.immigration.config.ts) ──────────
# The suite starts the app itself against a throwaway SQLite file and never
# touches the deployed site, whose database holds real applicants' records.
# Only set these if your checkout is somewhere other than the default.
# IT_APP_DIR=/Users/uvaizeba/.gemini/antigravity/scratch/immigrationtracker
# IT_PORT=3399
# IT_JWT_SECRET=immigration-tracker-e2e-secret
