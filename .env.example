# Playwright e2e credentials. Copy to .env and fill in.
# .env is gitignored — never commit real values. A working login was previously
# hardcoded in tests/helpers/auth.ts and reached a public repository.
E2E_EMAIL=
E2E_PASSWORD=

# Which tenant the suite runs against. Defaults to demo-kirana-store.
# These tests CREATE AND MODIFY records, so never point this at a live
# customer -- future-dispo-industries is refused outright.
E2E_TENANT_SLUG=demo-kirana-store
