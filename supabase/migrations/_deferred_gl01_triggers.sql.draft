-- GL-01 Migration: Automated Ledger Postings (Triggers)

-------------------------------------------------------------------------
-- 1. Helper function to safely fetch GL Account IDs
-------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION get_account_id(p_tenant_id UUID, p_code TEXT)
RETURNS UUID AS $$
DECLARE
    v_id UUID;
BEGIN
    SELECT id INTO v_id FROM gl_accounts WHERE tenant_id = p_tenant_id AND code = p_code LIMIT 1;
    RETURN v_id;
END;
$$ LANGUAGE plpgsql;

-------------------------------------------------------------------------
-- 2. SALES TRIGGER 
-- Posts: Rev, Cash/AR, COGS, Inventory
-------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION gl_posting_sales()
RETURNS TRIGGER AS $$
DECLARE
    v_journal_id UUID;
    v_total NUMERIC;
    v_cogs NUMERIC;
    v_status TEXT;
    v_tenant_id UUID;
    r_json JSONB := to_jsonb(NEW);
BEGIN
    -- Safely extract fields handling schema variations
    v_tenant_id := (r_json->>'tenant_id')::UUID;
    v_total := COALESCE((r_json->>'total_amount')::NUMERIC, (r_json->>'totalAmount')::NUMERIC, (r_json->>'amount')::NUMERIC, 0);
    v_cogs := COALESCE((r_json->>'total_cogs')::NUMERIC, (r_json->>'totalCogs')::NUMERIC, 0);
    v_status := COALESCE(r_json->>'payment_status', r_json->>'paymentStatus', 'UNPAID');

    -- Create Journal Header
    INSERT INTO gl_journals (tenant_id, reference_type, reference_id, description)
    VALUES (v_tenant_id, 'SALE', NEW.id::TEXT, 'Sale closing')
    RETURNING id INTO v_journal_id;

    -- Revenue (CREDIT 4000)
    INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit)
    VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '4000'), v_total);

    -- Cash vs AR (DEBIT 1000 or 1100)
    IF upper(v_status) = 'PAID' THEN
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1000'), v_total);
    ELSE
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1100'), v_total);
    END IF;

    -- COGS & Inventory (if COGS is present)
    IF v_cogs > 0 THEN
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit) -- COGS
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '5000'), v_cogs);
        
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit) -- Inventory
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1200'), v_cogs);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-------------------------------------------------------------------------
-- 3. EXPENSES TRIGGER
-- Posts: Opex, Cash
-------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION gl_posting_expenses()
RETURNS TRIGGER AS $$
DECLARE
    v_journal_id UUID;
    v_amount NUMERIC;
    v_title TEXT;
    v_tenant_id UUID;
    r_json JSONB := to_jsonb(NEW);
    v_cat TEXT;
BEGIN
    v_tenant_id := (r_json->>'tenant_id')::UUID;
    v_amount := COALESCE((r_json->>'amount')::NUMERIC, 0);
    v_title := COALESCE(r_json->>'title', r_json->>'description', 'Expense');
    v_cat := COALESCE(r_json->>'category', '');

    INSERT INTO gl_journals (tenant_id, reference_type, reference_id, description)
    VALUES (v_tenant_id, 'EXPENSE', NEW.id::TEXT, v_title)
    RETURNING id INTO v_journal_id;

    -- Handle Payroll separately if category matches
    IF upper(v_cat) LIKE '%PAYROLL%' THEN
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '5100'), v_amount);
    ELSE
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '5200'), v_amount);
    END IF;

    -- Credit Cash
    INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit)
    VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1000'), v_amount);

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-------------------------------------------------------------------------
-- 4. PURCHASES TRIGGER
-- Posts: Inventory, Cash/AP
-------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION gl_posting_purchases()
RETURNS TRIGGER AS $$
DECLARE
    v_journal_id UUID;
    v_total NUMERIC;
    v_status TEXT;
    v_tenant_id UUID;
    r_json JSONB := to_jsonb(NEW);
BEGIN
    v_tenant_id := (r_json->>'tenant_id')::UUID;
    v_total := COALESCE((r_json->>'total_amount')::NUMERIC, (r_json->>'amount')::NUMERIC, 
                        ((r_json->>'quantity')::NUMERIC * (r_json->>'unit_cost')::NUMERIC), 0);
    v_status := COALESCE(r_json->>'payment_status', r_json->>'paymentStatus', 'UNPAID');

    INSERT INTO gl_journals (tenant_id, reference_type, reference_id, description)
    VALUES (v_tenant_id, 'PURCHASE', NEW.id::TEXT, 'Stock Purchase')
    RETURNING id INTO v_journal_id;

    -- Debit Inventory (1200)
    INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
    VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1200'), v_total);

    -- Credit Cash vs AP (1000 or 2000)
    IF upper(v_status) = 'PAID' THEN
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1000'), v_total);
    ELSE
        INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit)
        VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '2000'), v_total);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-------------------------------------------------------------------------
-- 5. CLIENT PAYMENTS TRIGGER
-- Posts: Cash, AR
-------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION gl_posting_client_payments()
RETURNS TRIGGER AS $$
DECLARE
    v_journal_id UUID;
    v_amount NUMERIC;
    v_tenant_id UUID;
    r_json JSONB := to_jsonb(NEW);
BEGIN
    v_tenant_id := (r_json->>'tenant_id')::UUID;
    v_amount := COALESCE((r_json->>'amount')::NUMERIC, 0);

    INSERT INTO gl_journals (tenant_id, reference_type, reference_id, description)
    VALUES (v_tenant_id, 'PAYMENT', NEW.id::TEXT, 'Client Payment Received')
    RETURNING id INTO v_journal_id;

    -- Debit Cash (1000)
    INSERT INTO gl_lines (tenant_id, journal_id, account_id, debit)
    VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1000'), v_amount);

    -- Credit AR (1100)
    INSERT INTO gl_lines (tenant_id, journal_id, account_id, credit)
    VALUES (v_tenant_id, v_journal_id, get_account_id(v_tenant_id, '1100'), v_amount);

    RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-------------------------------------------------------------------------
-- ATTACH TRIGGERS
-------------------------------------------------------------------------
-- We drop them first so this file can be safely re-run without errors.

DROP TRIGGER IF EXISTS trg_gl_sales ON sales;
CREATE TRIGGER trg_gl_sales
AFTER INSERT ON sales
FOR EACH ROW EXECUTE FUNCTION gl_posting_sales();

DROP TRIGGER IF EXISTS trg_gl_expenses ON expenses;
CREATE TRIGGER trg_gl_expenses
AFTER INSERT ON expenses
FOR EACH ROW EXECUTE FUNCTION gl_posting_expenses();

DROP TRIGGER IF EXISTS trg_gl_purchases ON purchases;
CREATE TRIGGER trg_gl_purchases
AFTER INSERT ON purchases
FOR EACH ROW EXECUTE FUNCTION gl_posting_purchases();

DROP TRIGGER IF EXISTS trg_gl_client_payments ON client_payments;
CREATE TRIGGER trg_gl_client_payments
AFTER INSERT ON client_payments
FOR EACH ROW EXECUTE FUNCTION gl_posting_client_payments();
